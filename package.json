{
  "name": "api",
  "version": "2.0.0",
  "scripts": {
    "build": "npm run lint && tsc --project tsconfig.prod.json",
    "package": "sls package",
    "deploy": "sls deploy",
    "remove": "sls remove",
    "clean-install": "rm -rf ./node_modules && rm -r package-lock.json && npm i",
    "dev": "node -r dotenv/config ./node_modules/.bin/ts-node ./src/main",
    "dev:watch": "nodemon --exec \"npm run dev\" --watch ./src --ext .ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node ./dist/main.js",
    "type-check": "tsc -b --noEmit",
    "verify": "npm run lint && npm run type-check",
    "seed": "ts-node scripts/seed.ts",
    "seed:reference": "node scripts/seed-reference-data.js",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@types/multer": "^2.1.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.3.0",
    "@swc/core": "^1.15.11",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.1",
    "@types/supertest": "^6.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "js-yaml": "^5.5.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "serverless": "^4.46.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
